# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Directory where the SQLite database and generated artefacts are stored.
# Must be a writable path. In Docker this should be a mounted volume.
IMAGINARIUM_HOME=./runtime

# Primary operator name (used in authority hierarchy and audit logs).
IMAGINARIUM_PRIMARY_NAME=Primary Operator

# Fraction of realised profit available for reinvestment (0–1).
IMAGINARIUM_REINVESTMENT_RATE=0.25

# Base URL used by the Streamlit dashboard when querying the FastAPI API.
# IMAGINARIUM_API_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Optional — Stripe integration
# Leave unset (or empty) to run in local/stub mode with no real payments.
# ---------------------------------------------------------------------------

# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Currency code (ISO 4217, lowercase). Default: gbp
# CURRENCY=gbp

# ---------------------------------------------------------------------------
# Optional — Ollama / local LLM
# Leave unset to run with deterministic stub reasoning.
# ---------------------------------------------------------------------------

# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3
